# Local development ports
CLIENT_PORT=3000
CORE_PORT=3001
AUTH_PORT=3002
NOTIFICATIONS_PORT=3003

# PostgreSQL
POSTGRES_DB=innogram
POSTGRES_USER=innogram
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USER=innogram
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://innogram:change-me@localhost:5672

# Service URLs for local development
CLIENT_URL=http://localhost:3000
CORE_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
NOTIFICATIONS_SERVICE_URL=http://localhost:3003

# Future authentication integration: replace placeholders before implementation
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback

# Future notification and upload integration
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Development
NODE_ENV=development
LOG_LEVEL=debug
